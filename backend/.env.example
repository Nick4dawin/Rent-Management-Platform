# ================================
# SERVER CONFIGURATION
# ================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ================================
# DATABASE CONFIGURATION
# ================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/rent_management?schema=public"

# ================================
# JWT CONFIGURATION
# ================================
# IMPORTANT: Generate strong random secrets for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production-minimum-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# ================================
# CORS CONFIGURATION
# ================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003

# ================================
# FILE UPLOAD CONFIGURATION
# ================================
UPLOAD_DIR=./uploads
# Max file size in bytes (10MB = 10485760)
UPLOAD_MAX_SIZE=10485760

# ================================
# SMS PROVIDER CONFIGURATION
# ================================
# Options: 'twilio' or 'console' (console for development)
SMS_PROVIDER=console

# Twilio Configuration (if using SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ================================
# EMAIL CONFIGURATION (Optional)
# ================================
# For password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@rentmanagement.com

# ================================
# LOGGING CONFIGURATION
# ================================
# Options: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info
LOG_DIR=./logs

# ================================
# RATE LIMITING
# ================================
# Window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# INITIAL SUPER ADMIN CREDENTIALS
# ================================
# These are used ONLY for initial seeding
SUPER_ADMIN_EMAIL=admin@rentmanagement.com
SUPER_ADMIN_PASSWORD=Admin123!ChangeMe
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ================================
# OPTIONAL: REDIS CONFIGURATION
# ================================
# For session management and caching (future enhancement)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# ================================
# OPTIONAL: PDF GENERATION
# ================================
# PDF service URL (if using external service)
# PDF_SERVICE_URL=http://localhost:3005

# ================================
# OPTIONAL: IOT GATEWAY INTEGRATION
# ================================
# wM-Bus Gateway
# WMBUS_GATEWAY_URL=http://localhost:8080
# WMBUS_API_KEY=your_api_key

# ZigBee Gateway
# ZIGBEE_GATEWAY_URL=http://localhost:8081
# ZIGBEE_API_KEY=your_api_key
