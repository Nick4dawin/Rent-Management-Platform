# Test Environment Configuration
NODE_ENV=test
PORT=3001

# Test Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/rent_management_test?schema=public"

# JWT (use different secrets for testing)
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-refresh-token-secret-for-testing
JWT_REFRESH_EXPIRES_IN=2h

# CORS
CORS_ORIGIN=http://localhost:3000

# File Upload
UPLOAD_DIR=./test-uploads
UPLOAD_MAX_SIZE=10485760

# SMS (use console for testing)
SMS_PROVIDER=console

# Logging
LOG_LEVEL=error
LOG_DIR=./test-logs

# Rate Limiting (disabled for tests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Super Admin
SUPER_ADMIN_EMAIL=admin@test.com
SUPER_ADMIN_PASSWORD=TestAdmin123!
SUPER_ADMIN_FIRST_NAME=Test
SUPER_ADMIN_LAST_NAME=Admin
